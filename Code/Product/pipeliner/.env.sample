# ── LLM ──────────────────────────────────────────────
# Required only when provider = "openai"
OPENAI_API_KEY=sk-...

# Required only when provider = "lmstudio"
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# ── Neo4j ────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Supabase ─────────────────────────────────────────
# Project URL  (Settings → API → Project URL)
SUPABASE_URL=https://<project-ref>.supabase.co

# Service-role key (Settings → API → service_role secret)
# ⚠️  Use the service_role key, NOT the anon key — the anon
#     key is subject to RLS and will fail on storage uploads
#     unless you've configured public bucket policies.
SUPABASE_KEY=eyJhbGciOiJI...
