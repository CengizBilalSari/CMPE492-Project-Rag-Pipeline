# =============================================================================
# GraphRAG vLLM Deployment — Configuration (GCE VM)
# =============================================================================

# --- GCP Settings ---
REGION="us-central1"
ZONE="us-central1-a"

# --- VM Settings ---
VM_NAME="graphrag-vllm"
MACHINE_TYPE="g2-standard-8"       # 8 vCPU, 32 GB RAM, 1× NVIDIA L4 GPU
DISK_SIZE_GB="100"
IMAGE_FAMILY="pytorch-2-7-cu128-ubuntu-2204-nvidia-570"
IMAGE_PROJECT="deeplearning-platform-release"

# --- Firewall ---
FIREWALL_RULE="allow-vllm"
VLLM_PORT="8000"

# --- vLLM Model ---
MODEL="Qwen/Qwen2.5-7B-Instruct"
MAX_MODEL_LEN="16384"
GPU_MEMORY_UTILIZATION="0.9"
DTYPE="half"

# --- Budget Protection ---
BUDGET_AMOUNT="10500"              # TRY — adjust based on your credit
BUDGET_DISPLAY_NAME="graphrag-budget"
BUDGET_THRESHOLD="0.8"             # Alert at 80% of budget
PUBSUB_TOPIC="graphrag-budget-alert"
FUNCTION_NAME="graphrag-stop-billing"
FUNCTION_RUNTIME="python312"
FUNCTION_ENTRY_POINT="stop_billing"
